{
  "$defs": {
    "JsonValue": {},
    "ModuleSelection": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "persona": {
              "type": "string"
            }
          },
          "required": [
            "persona"
          ]
        },
        {
          "properties": {
            "skills": {
              "minItems": 1
            }
          },
          "required": [
            "skills"
          ]
        },
        {
          "properties": {
            "memory": {
              "minItems": 1
            }
          },
          "required": [
            "memory"
          ]
        }
      ],
      "properties": {
        "memory": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,63}(?:@(?:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|\\^?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?))?$(?![\\s\\S])",
            "type": "string"
          },
          "title": "Memory",
          "type": "array"
        },
        "persona": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,63}(?:@(?:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|\\^?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?))?$(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona"
        },
        "skills": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,63}(?:@(?:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|\\^?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?))?$(?![\\s\\S])",
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "ModuleSelection",
      "type": "object"
    },
    "RenderOptions": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "plain",
            "openai-chat",
            "anthropic-messages"
          ],
          "title": "Target",
          "type": "string"
        },
        "token_budget": {
          "default": 8000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "title": "RenderOptions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "extensions": {
      "patternProperties": {
        "^x-": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Extensions",
      "type": "object"
    },
    "id": {
      "not": {
        "enum": [
          "aux",
          "clock$",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "com\u00b2",
          "com\u00b3",
          "com\u00b9",
          "con",
          "conin$",
          "conout$",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9",
          "lpt\u00b2",
          "lpt\u00b3",
          "lpt\u00b9",
          "nul",
          "prn"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "composition",
      "title": "Kind",
      "type": "string"
    },
    "modules": {
      "$ref": "#/$defs/ModuleSelection"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "render": {
      "$ref": "#/$defs/RenderOptions"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxLength": 32,
      "title": "Tags",
      "type": "array"
    },
    "variables": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Variables",
      "type": "object"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "version",
    "name",
    "modules",
    "render"
  ],
  "title": "Composition",
  "type": "object",
  "x-reliclab-semantic-checks": [
    "UTF-8 body byte limit and valid Unicode encoding",
    "portable path policy",
    "reserved IDs in references and root aliases",
    "unique reference IDs per selection slot",
    "finite JSON numbers",
    "strict Python integer representation",
    "name whitespace normalization and tag deduplication"
  ]
}
