{
  "$defs": {
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "body": {
            "const": ""
          },
          "path": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        },
        "required": [
          "root",
          "path"
        ]
      },
      "if": {
        "properties": {
          "source": {
            "const": "inline"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "pattern": "\\S"
          },
          "path": {
            "type": "null"
          },
          "root": {
            "type": "null"
          }
        },
        "required": [
          "body"
        ]
      }
    }
  ],
  "properties": {
    "author": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "depth": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Depth",
      "type": "integer"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "extensions": {
      "patternProperties": {
        "^x-": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Extensions",
      "type": "object"
    },
    "id": {
      "not": {
        "enum": [
          "aux",
          "clock$",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "com\u00b2",
          "com\u00b3",
          "com\u00b9",
          "con",
          "conin$",
          "conout$",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9",
          "lpt\u00b2",
          "lpt\u00b3",
          "lpt\u00b9",
          "nul",
          "prn"
        ]
      },
      "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "memory",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "root": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "on-demand",
      "enum": [
        "always",
        "on-demand"
      ],
      "title": "Scope",
      "type": "string"
    },
    "source": {
      "enum": [
        "inline",
        "file",
        "glob"
      ],
      "title": "Source",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxLength": 32,
      "title": "Tags",
      "type": "array"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "version",
    "name",
    "source"
  ],
  "title": "Memory",
  "type": "object",
  "x-reliclab-semantic-checks": [
    "UTF-8 body byte limit and valid Unicode encoding",
    "portable path policy",
    "reserved IDs in references and root aliases",
    "unique reference IDs per selection slot",
    "finite JSON numbers",
    "strict Python integer representation",
    "name whitespace normalization and tag deduplication"
  ]
}
